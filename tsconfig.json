{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "noCheck": true,
    "skipLibCheck": true
  },
  "include": ["web/**/*.ts", "web/**/*.d.ts", "scripts/**/*.ts", "pages.config.ts"]
}
